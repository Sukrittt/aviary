{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/notifications/run",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/gc",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/billing",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/emails",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/emails",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/emails",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/emails",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/publish",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/evening-check",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/warm",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/warm/30",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/warm/60",
      "schedule": "*/5 * * * *"
    }
  ]
}
