# Copy this file to .env.local and fill in your values.

# MongoDB connection string (Atlas or local). Required — the API reads/writes
# these collections, and `npm run db:migrate` seeds them from your local CSVs.
MONGODB_URI=

# WorkOS AuthKit. The client id and API key come from the WorkOS dashboard;
# use the SAME WorkOS environment locally and in production, or your local
# sign-in resolves to a different user id than production and the account looks
# empty. No client secret is needed: the web app authenticates with the API key
# and the mobile app uses PKCE.
WORKOS_CLIENT_ID=
WORKOS_API_KEY=

# Encrypts the AuthKit session cookie. 32+ chars: openssl rand -base64 24
WORKOS_COOKIE_PASSWORD=

# Where WorkOS sends users after sign-in. Must be registered as a redirect URI
# in the WorkOS dashboard, alongside the production URL and the mobile app's
# com.sukrit04.Mobile://callback.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback

# The user id that owns the read-only sample data shown to signed-out visitors.
# Any stable string that can never be a real WorkOS user id.
DEMO_USER_ID=demo

# The user id that owns the dummy/seed data written by scripts/
# (generate-dummy-data.mjs, check-data.mjs, check-existing.mjs). Set to your
# WorkOS user id, e.g. user_xxxxxxxxx.
USER_ID=

# Email used by scripts/find-user.mjs to look up a user.
USER_EMAIL=

# Gemini API key for LLM-assisted features (category-suggest fallback, AI
# transaction scan). Required for those endpoints; get one at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when
# invoking /api/ai/scan-transactions. Set this in the Vercel project env vars;
# Vercel attaches the header automatically to its own cron-triggered requests.
CRON_SECRET=

# Field-level encryption key for sensitive Mongo fields (lib/crypto.ts,
# lib/encryptedFields.ts) — 32 bytes, base64: openssl rand -base64 32
# Same key across local/preview/production, or data encrypted in one
# environment can't be read in another. Losing this key permanently loses
# every encrypted value — save it in a password manager, not just here.
FIELD_KEY_V1=

# Vercel Blob store token for generated export files (lib/exports.ts).
# Create a Blob store in the Vercel dashboard; `vercel env pull` fetches this
# automatically in a linked project.
BLOB_READ_WRITE_TOKEN=

# RevenueCat — billing (lib/billing/*). The app `Aviary` (appdfd7e37e80),
# Google Play package com.sukrit04.envelope.
#
# SECRET key (sk_… / the v1 secret from Project settings → API keys). Server
# only — it can read and modify every customer's subscription. Never ship it
# in the mobile app; the app gets the *public* SDK key instead.
REVENUECAT_SECRET_KEY=

# The value RevenueCat sends verbatim as the `Authorization` header on every
# webhook delivery. Set the same string in RevenueCat → Integrations →
# Webhooks → Authorization header. Generate with: openssl rand -base64 32
REVENUECAT_WEBHOOK_SECRET=

# Entitlement identifier configured in RevenueCat. Defaults to aviary_pro;
# set this only if the identifier is renamed in the dashboard.
REVENUECAT_ENTITLEMENT_ID=aviary_pro

# Razorpay — web checkout (lib/billing/razorpay.ts). Android keeps Google Play
# via RevenueCat above; either purchase unlocks the account everywhere.
# Leave any of these unset and web checkout stays off (the picker never shows).
#
# Key pair from Razorpay Dashboard → Account & Settings → API keys. Test keys
# (rzp_test_…) write sandbox rows, so test purchases never mix with real ones.
# The secret is server only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Plan ids (plan_…) from Dashboard → Subscriptions → Plans. One monthly, one
# yearly. Prices shown on the site are read from these plans.
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_YEARLY=

# Secret set on the webhook (Dashboard → Webhooks) pointing at
# https://<host>/api/billing/webhooks/razorpay. Subscribe to the
# subscription.* events (activated, charged, pending, halted, cancelled,
# completed, paused, resumed). Generate with: openssl rand -base64 32
RAZORPAY_WEBHOOK_SECRET=

# PostHog — product analytics (src/lib/analytics.ts). Use the same project and
# key as the mobile app's EXPO_PUBLIC_POSTHOG_KEY, so someone using both apps
# is one person there. Public by design: it can only send events. Left empty,
# the web app sends nothing and keeps working.
NEXT_PUBLIC_POSTHOG_KEY=
# Optional. Defaults to the US cloud.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional: lets one reviewer email (e.g. Razorpay KYC) sign in with a fixed code
# instead of an emailed one. Leave unset except during a review.
REVIEW_LOGIN_EMAIL=
REVIEW_LOGIN_CODE=

# Resend — transactional emails. Server only; never use a NEXT_PUBLIC_ prefix.
# New accounts receive the welcome email after authentication; failures are
# retried on sign-in and by /api/cron/emails (authorized with CRON_SECRET).
RESEND_API_KEY=
# Optional overrides. The sender's domain must be verified in Resend.
RESEND_FROM_EMAIL=Aviary <hello@useaviary.com>
RESEND_REPLY_TO=aviary.playreview@gmail.com
